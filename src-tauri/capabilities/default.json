{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main", "alert"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "log:default",
    "upload:default",
    "dialog:default",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}